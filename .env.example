# Copy to .env and fill in whichever you use. .env is gitignored; this file
# is the committed template, so never put a real key here.
#
#     cp .env.example .env
#
# Then, in Python:
#
#     from mcdakit.ai_providers import load_env, anthropic
#     load_env()
#     ask = anthropic()

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# GEMINI_API_KEY is read as a fallback when GOOGLE_API_KEY is unset.
# GEMINI_API_KEY=

# Local models need no key at all:
#     ask = ollama("llama3")
#     ask = openai_compatible("mistral-7b", "http://localhost:8000/v1")
